---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import subsidies from '../data/subsidies.json';

const sorted = [...subsidies].sort((a, b) => new Date(a.deadline) - new Date(b.deadline));
const urgent = sorted.filter((s) => s.urgent).slice(0, 4);
const featured = urgent.length ? urgent : sorted.slice(0, 4);

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate - a.data.pubDate)
  .slice(0, 3);

function formatDeadline(dateStr) {
  const d = new Date(dateStr);
  const days = Math.ceil((d - new Date()) / 86400000);
  const label = d.toLocaleDateString('zh-TW', { month: 'long', day: 'numeric' });
  return { label, days };
}
---

<Layout title="首頁">
  <section class="hero">
    <div>
      <p class="hero-stat-number">{subsidies.length}</p>
      <p class="hero-stat-label">件目前開放中的補助方案</p>
    </div>
    <p class="hero-lede">
      我們每日彙整各政府單位公告的補助與獎助計畫,整理成同一份清單,
      讓申請期限與適用對象一目了然。
    </p>
  </section>

  <div class="section-head">
    <h2>即將截止</h2>
    <a class="see-all" href="/subsidies/">查看全部方案</a>
  </div>
  <ul class="subsidy-list">
    {featured.map((s, i) => {
      const { label, days } = formatDeadline(s.deadline);
      return (
        <li>
          <a class="subsidy-row" href={s.url} target="_blank" rel="noopener">
            <span class="subsidy-index">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="subsidy-title">{s.title}</p>
              <p class="subsidy-summary">{s.summary}</p>
              <div class="subsidy-tags">
                <span class="tag">{s.category}</span>
                <span class="tag agency">{s.agency}</span>
              </div>
            </div>
            <div class="subsidy-meta">
              <div class="subsidy-amount">{s.amount}</div>
              <span class={`deadline ${days <= 14 ? 'urgent' : ''}`}>
                {days > 0 ? `截止 ${label}` : '已截止'}
              </span>
            </div>
          </a>
        </li>
      );
    })}
  </ul>

  <div class="section-head">
    <h2>觀察筆記</h2>
    <a class="see-all" href="/blog/">閱讀更多文章</a>
  </div>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-row" href={`/blog/${post.slug}/`}>
          <p class="post-date">{post.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
          <p class="post-title">{post.data.title}</p>
          <p class="post-desc">{post.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</Layout>
